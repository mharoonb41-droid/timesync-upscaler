# Auto-detect text files and normalize line endings to LF on commit
* text=auto

# Source code and scripts
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.srt text eol=lf
*.qss text eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary media assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.bmp binary
*.gif binary
*.mp3 binary
*.wav binary
*.m4a binary
*.mp4 binary
*.ts binary
